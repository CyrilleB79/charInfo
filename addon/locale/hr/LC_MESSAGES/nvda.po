#: addon\globalPlugins\charInfo\__init__.py:1073
msgid "Voice language"
msgstr "Jezik glasa"

#. Translators: An option text in the symbol description section of the character info report.
#: addon\globalPlugins\charInfo\__init__.py:1081
msgid "NVDA interface language"
msgstr "Jezik NVDA sučelja"

#. Translators: A part of the message presented in input help mode.
#: addon\globalPlugins\charInfo\__init__.py:1318
msgid ". Pressing four times presents a message with detailed information on this character."
msgstr ". Kad se pritisne četiri puta prikazuje detaljne podatake o ovom znaku."

#. Translators: The message presented in input help mode.
#: addon\globalPlugins\charInfo\__init__.py:1409
msgid "Presents a message with detailed information on the character of the current navigator object where the review cursor is situated."
msgstr "Prikazuje podatke o znaku pod objektom navigatora gdje se nalazi pregledni kursor."

#. Translators: The message presented in input help mode.
#: addon\globalPlugins\charInfo\__init__.py:1420
msgid "Presents a message with detailed information on the character at the position of the caret."
msgstr "Prikazuje poruku s detaljnim podacima o znaku pod kursorom."

#. Translators: Reported when there is no caret
#: addon\globalPlugins\charInfo\__init__.py:1436
msgid "No caret"
msgstr "Nema kursora"

#. Translators: The description of a command of this add-on.
#: addon\globalPlugins\charInfo\__init__.py:1442
msgid "Opens Character Information add-on settings"
msgstr "Otvara postavke dodatka Informacije o znakovima"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:22
msgid "Character information"
msgstr "Podaci o znaku"

#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:26
msgid "This add-on allows to present in a message various information about a character.\n"
"\t\tIt also allows to customize the information reported on a character when using review cursor character navigation commands or multiple presses of the review character command."
msgstr "Ovaj dodatak omogućuje prikazivanje u poruci različitih informacija o znaku.\n"
"\t\tTakođer omogućuje prilagodbu informacija prijavljenih na znaku kada se koriste naredbe za navigaciju znakovima pokazivača pregleda ili više pritisaka naredbe znaka pregleda."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:34
msgid "* Update to Unicode 17.0.\n"
"* Fixed a bug causing the review cursor at the end of a line to jump to next line when moved right, instead of reporting the end of the line.\n"
"* Compatibility with NVDA 2026.1.\n"
"* Drops compatibility with NVDA below 2024.1. The last version compatible with NVDA 2022.3.3 is the [3.7][5].\n\n"
"[5]: https://github.com/CyrilleB79/charInfo/releases/download/V3.7/charInfo-3.7.nvda-addon\n"
msgstr ""

