msgstr "Puhu Microsoftin fontin oma merkki (nimi, fontti ja vastaava Unicode-nimi)"

#. Translators: This is the label for a group of action choices in the add-on's settings panel
#: addon\globalPlugins\charInfo\ciGui.py:55
msgid "Action for multiple presses of the report review character command"
msgstr "Toiminto Puhu tarkastelukohdistimen kohdalla oleva merkki -komennon useille painalluksille"

#. Translators: This is the label for a checkbox in the Character Information settings panel.
#: addon\globalPlugins\charInfo\ciGui.py:66
msgid "Remember these action during character navigation"
msgstr "Muista nämä toiminnot merkeittäin liikuttaessa"

#. Translators: This is the label for the action definition comboboxes in the Character Information settings
#. panel.
#: addon\globalPlugins\charInfo\ciGui.py:73
#, python-brace-format
msgid "{n} presses:"
msgstr "{n} painallusta:"

#. Translators: Title on the char info displayed message
#: addon\globalPlugins\charInfo\__init__.py:125
msgid "Detailed character information"
msgstr "Yksityiskohtaiset merkin tiedot"

#. Translators: Reported in the tables when no value is defined for a property of a specific character.
#: addon\globalPlugins\charInfo\__init__.py:146
