#. Translators: An option in an action definition combobox Character Information setting panel.
#: addon\globalPlugins\charInfo\ciGui.py:24
msgid "Report the character"
msgstr "Сообщить символ"

#. Translators: An option in an action definition combobox Character Information setting panel.
#: addon\globalPlugins\charInfo\ciGui.py:26
msgid "Report the character description"
msgstr "Сообщить описание символа"

#. Translators: An option in an action definition combobox Character Information setting panel.
#: addon\globalPlugins\charInfo\ciGui.py:28
msgid "Report the character number"
msgstr "Сообщить номер символа"

#. Translators: An option in an action definition combobox Character Information setting panel.
#: addon\globalPlugins\charInfo\ciGui.py:30
msgid "Display information on the character"
msgstr "Показать информацию о символе"

#. Translators: An option in an action definition combobox Character Information setting panel.
#: addon\globalPlugins\charInfo\ciGui.py:32
msgid "Report the CLDR locale name of the character"
msgstr "Сообщить название символа в соответствии с языковым стандартом CLDR"

#. Translators: An option in an action definition combobox Character Information setting panel.
#: addon\globalPlugins\charInfo\ciGui.py:34
msgid "Report the CLDR English name of the character"
msgstr "Сообщить английское название символа CLDR"

#. Translators: An option in an action definition combobox Character Information setting panel.
#: addon\globalPlugins\charInfo\ciGui.py:36
msgid "Report the locale name of the character"
msgstr "Сообщить языковое название символа"

#. Translators: An option in an action definition combobox Character Information setting panel.
#: addon\globalPlugins\charInfo\ciGui.py:38
msgid "Report the English name of the character"
msgstr "Сообщить английское название символа"

#: addon\globalPlugins\charInfo\ciGui.py:42
msgid "Report Microsoft font proprietary character (name, font and equivalent Unicode name)"
msgstr "Сообщить о проприетарном символе шрифта Microsoft (название, шрифт и эквивалентное название Юникода)"

#. Translators: This is the label for a group of action choices in the add-on's settings panel
#: addon\globalPlugins\charInfo\ciGui.py:55
msgid "Action for multiple presses of the report review character command"
msgstr "Действие при многократном нажатии команды просмотра информации о символе"

#. Translators: This is the label for a checkbox in the Character Information settings panel.
#: addon\globalPlugins\charInfo\ciGui.py:66
msgid "Remember these action during character navigation"
msgstr "Запомнить действия при навигации по символам"

#. Translators: This is the label for the action definition comboboxes in the Character Information settings
#. panel.
#: addon\globalPlugins\charInfo\ciGui.py:73
#, python-brace-format
msgid "{n} presses:"
msgstr "{n} нажатий:"

#. Translators: Title on the char info displayed message
#: addon\globalPlugins\charInfo\__init__.py:125
msgid "Detailed character information"
msgstr "Подробная информация о символе»"

#. Translators: Reported in the tables when no value is defined for a property of a specific character.
#: addon\globalPlugins\charInfo\__init__.py:146
msgid "[Not defined]"
msgstr "[Не определено]"

#. Translators: Reported in the symbol and character description tables when no file corresponding to the row
