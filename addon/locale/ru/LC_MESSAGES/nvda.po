msgstr "Описание символа в NVDA"

#. Translators: A section name in the char info displayed message
#: addon\globalPlugins\charInfo\__init__.py:337
msgid "Character description in NVDA"
msgstr "Описание символа в NVDA"

#. Translators: Reported in the Unicode information table when the character does not belong to any block.
#: addon\globalPlugins\charInfo\__init__.py:642
msgid "No Block"
msgstr "Блок отсутствует"

#. Translators: The value of an option reported in symbol description section of the character info report.
#: addon\globalPlugins\charInfo\__init__.py:808
msgid "On"
msgstr "Включено"

#. Translators: The value of an option reported in symbol description section of the character info report.
#: addon\globalPlugins\charInfo\__init__.py:811
msgid "Off"
msgstr "Выключено"

#. Translators: A column header on the char info displayed message
#: addon\globalPlugins\charInfo\__init__.py:945
msgid "Value"
msgstr "Значение"

#. Translators: A column title on the char info displayed message
#: addon\globalPlugins\charInfo\__init__.py:948
#, python-brace-format
msgid "Character {numChar}"
msgstr "Символ {numChar}"

#. Translators: A column title on the char info displayed message
#: addon\globalPlugins\charInfo\__init__.py:953
#: addon\globalPlugins\charInfo\__init__.py:974
msgid "Attribute"
msgstr "Атрибут"

#. Translators: A piece of text in the symbol description section of the character info report.
#: addon\globalPlugins\charInfo\__init__.py:1017
msgid "Options used to compute the symbol:"
msgstr "Параметры, используемые для вычисления символа:"

#. Translators: An option text in the symbol description section of the character info report.
#: addon\globalPlugins\charInfo\__init__.py:1073
msgid "Voice language"
msgstr "Язык голоса"

#. Translators: An option text in the symbol description section of the character info report.
#: addon\globalPlugins\charInfo\__init__.py:1081
msgid "NVDA interface language"
msgstr "Язык NVDA"

#. Translators: A part of the message presented in input help mode.
#: addon\globalPlugins\charInfo\__init__.py:1318
msgid ". Pressing four times presents a message with detailed information on this character."
msgstr ". При нажатии четыре раза появляется сообщение с подробной информацией об этом символе."

#. Translators: The message presented in input help mode.
#: addon\globalPlugins\charInfo\__init__.py:1409
msgid "Presents a message with detailed information on the character of the current navigator object where the review cursor is situated."
msgstr "Показывает сообщение с подробной информацией о символе текущего объекта навигатора, на котором находится просмотровый курсор."

#. Translators: The message presented in input help mode.
#: addon\globalPlugins\charInfo\__init__.py:1420
msgid "Presents a message with detailed information on the character at the position of the caret."
msgstr "Показывает сообщение с подробной информацией о символе под кареткой."

#. Translators: Reported when there is no caret
#: addon\globalPlugins\charInfo\__init__.py:1436
msgid "No caret"
msgstr "Нет каретки"

#. Translators: The description of a command of this add-on.
#: addon\globalPlugins\charInfo\__init__.py:1442
msgid "Opens Character Information add-on settings"
msgstr "Открывает настройки дополнения"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:22
msgid "Character information"
msgstr "Информация о символе"

#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:26
msgid "This add-on allows to present in a message various information about a character.\n"
"\t\tIt also allows to customize the information reported on a character when using review cursor character navigation commands or multiple presses of the review character command."
msgstr "Это дополнение позволяет отображать в сообщении различную информацию о символе.\n"
"\t\tОно также позволяет настраивать информацию, сообщаемую о символе, при использовании команд навигации по символам с помощью просмотрового курсора или многократного нажатия команды просмотра символов."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:34
msgid "* Update to Unicode 17.0.\n"
"* Fixed a bug causing the review cursor at the end of a line to jump to next line when moved right, instead of reporting the end of the line.\n"
"* Compatibility with NVDA 2026.1.\n"
"* Drops compatibility with NVDA below 2024.1. The last version compatible with NVDA 2022.3.3 is the [3.7][5].\n\n"
"[5]: https://github.com/CyrilleB79/charInfo/releases/download/V3.7/charInfo-3.7.nvda-addon\n"
msgstr ""

