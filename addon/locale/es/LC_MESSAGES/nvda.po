#: addon\globalPlugins\charInfo\__init__.py:642
msgid "No Block"
msgstr "Sin Bloque"

#. Translators: The value of an option reported in symbol description section of the character info report.
#: addon\globalPlugins\charInfo\__init__.py:808
msgid "On"
msgstr "Activado"

#. Translators: The value of an option reported in symbol description section of the character info report.
#: addon\globalPlugins\charInfo\__init__.py:811
msgid "Off"
msgstr "Desactivado"

